<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="topmenu_desktop">
            <action method="setTemplate" ifconfig="shopbybrand/general/enabled">
                <argument name="template" xsi:type="string">HyvaElsner_MegaMenu::html/header/menu/desktop.phtml</argument>
            </action>
        </referenceBlock>
        <referenceBlock name="topmenu_mobile">
            <action method="setTemplate" ifconfig="shopbybrand/general/enabled">
                <argument name="template" xsi:type="string">HyvaElsner_MegaMenu::html/header/menu/mobile.phtml</argument>
            </action>
        </referenceBlock>
    </body>
</page>