<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="social_feeds" translate="label" type="text" sortOrder="300" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Instagram Feeds</label>
            <tab>general</tab>
            <resource>Elsnertech_SocialFeeds::config</resource>
            
            <group id="instagram" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Instagram Settings</label>
                <field id="access_token" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Instagram Access Token</label>
                    <comment>Get your access token from Instagram Basic Display API</comment>
                </field>
                <field id="enabled" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Instagram Feed</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="token_last_refreshed" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Access Token Last Refreshed</label>
                    <comment>Set automatically by the daily token-refresh cron job. Do not edit.</comment>
                </field>
                <field id="token_expires_at" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Access Token Expires At</label>
                    <comment>Set automatically by the daily token-refresh cron job. Do not edit.</comment>
                </field>
                <field id="notify_email" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Expiry Warning Email</label>
                    <comment>Sent a warning email if the access token is within 24 hours of expiring and the automatic refresh has not renewed it.</comment>
                </field>
            </group>
            
            <group id="general" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General Settings</label>
                <field id="posts_count" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Number of Posts to Display</label>
                    <validate>validate-digits validate-digits-range digits-range-1-20</validate>
                    <comment>Maximum 20 posts</comment>
                </field>
                <field id="cache_time" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Cache Time (minutes)</label>
                    <validate>validate-digits</validate>
                    <comment>How long to cache the feed data (default: 30 minutes)</comment>
                </field>
                <field id="enable_animations" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Hover Animations</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
        </section>
    </system>
</config>