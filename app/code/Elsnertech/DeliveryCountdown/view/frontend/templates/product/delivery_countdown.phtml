<script>
/**
 * The component is handed the delivery rules, never a decision taken when the page
 * was rendered. Product pages sit in the full page cache, so anything worked out on
 * the server goes stale as soon as the clock passes the cutoff or the day changes.
 * Deciding here, against the shopper's own clock, keeps a cached page correct.
 */
function deliveryCountdown(config) {
    return {
        showNextDay: false,
        message: '',
        hours: 0,
        minutes: 0,
        seconds: 0,
        intervalId: null,

        init() {
            this.refresh();
            this.intervalId = setInterval(() => this.refresh(), 1000);
        },

        destroy() {
            if (this.intervalId) {
                clearInterval(this.intervalId);
                this.intervalId = null;
            }
        },

        /**
         * Wall clock reading in the store's timezone, whatever timezone the
         * shopper's device happens to be set to.
         */
        storeParts(date) {
            const parts = {};
            const formatter = new Intl.DateTimeFormat('en-US', {
                timeZone: config.timezone,
                hour12: false,
                year: 'numeric', month: '2-digit', day: '2-digit',
                hour: '2-digit', minute: '2-digit', second: '2-digit'
            });

            formatter.formatToParts(date).forEach(part => {
                if (part.type !== 'literal') {
                    parts[part.type] = parseInt(part.value, 10);
                }
            });

            // Some engines report midnight as hour 24.
            if (parts.hour === 24) {
                parts.hour = 0;
            }

            return parts;
        },

        /**
         * Difference in milliseconds between the store's wall clock and UTC at this
         * instant, so a store-local date and time can be turned back into a real one.
         */
        storeOffset(date, parts) {
            const asIfUtc = Date.UTC(
                parts.year, parts.month - 1, parts.day,
                parts.hour, parts.minute, parts.second
            );

            return asIfUtc - Math.floor(date.getTime() / 1000) * 1000;
        },

        /** The instant a given store-local day reaches the cutoff. */
        cutoffAt(day, offset) {
            return Date.UTC(day.year, day.month - 1, day.day, config.cutoffHour, config.cutoffMinute, 0) - offset;
        },

        isWorkingDay(day) {
            const weekday = new Date(Date.UTC(day.year, day.month - 1, day.day)).getUTCDay();

            return !config.nonWorkingDays.includes(weekday);
        },

        /** First working day strictly after the given one. */
        nextWorkingDay(day) {
            const date = new Date(Date.UTC(day.year, day.month - 1, day.day));

            // Bounded so a misconfiguration can never spin the browser.
            for (let i = 0; i < 8; i++) {
                date.setUTCDate(date.getUTCDate() + 1);

                if (!config.nonWorkingDays.includes(date.getUTCDay())) {
                    break;
                }
            }

            return { year: date.getUTCFullYear(), month: date.getUTCMonth() + 1, day: date.getUTCDate() };
        },

        refresh() {
            const now = new Date();
            const parts = this.storeParts(now);
            const offset = this.storeOffset(now, parts);
            const nowMs = Math.floor(now.getTime() / 1000) * 1000;

            const today = { year: parts.year, month: parts.month, day: parts.day };
            const todayIsWorkingDay = this.isWorkingDay(today);
            const beforeCutoff = nowMs < this.cutoffAt(today, offset);

            // Same day is only on the table on a working day, before the cutoff.
            const isSameDay = config.sameDayEnabled && todayIsWorkingDay && beforeCutoff;
            const deliveryDay = isSameDay ? today : this.nextWorkingDay(today);

            // Orders still count towards today until the cutoff passes; after that,
            // or on a non-working day, the next chance is the next working day.
            const orderDeadline = (todayIsWorkingDay && beforeCutoff)
                ? this.cutoffAt(today, offset)
                : this.cutoffAt(this.nextWorkingDay(today), offset);

            const remaining = Math.max(0, Math.floor((orderDeadline - nowMs) / 1000));

            this.showNextDay = !isSameDay;
            this.message = this.renderMessage(
                isSameDay ? config.sameDayMessage : config.nextDayMessage,
                deliveryDay,
                today
            );
            this.hours = Math.floor(remaining / 3600);
            this.minutes = Math.floor((remaining % 3600) / 60);
            this.seconds = remaining % 60;
        },

        /**
         * Same placeholders, and the same date format, the server side uses.
         *
         * The month names are spelled out rather than taken from Intl on purpose:
         * PHP's "M" is always the three letter English abbreviation, while browsers
         * follow their own locale data, which renders September as "Sept" on newer
         * ICU versions and "Sep" on older ones.
         */
        renderMessage(template, deliveryDay, today) {
            const months = [
                'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
                'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'
            ];
            const formatted = String(deliveryDay.day).padStart(2, '0') + ' ' + months[deliveryDay.month - 1];

            return (template || '')
                .replace(/\{day\}/g, this.dayLabel(deliveryDay, today))
                .replace(/\{date\}/g, formatted)
                .replace(/\{time\}/g, config.cutoffLabel);
        },

        /**
         * Word for the {day} placeholder: "Tomorrow" when the parcel arrives the
         * very next day, and the plain preposition once a non-working day has
         * pushed it further out. The words come from the server so they stay
         * translatable.
         */
        dayLabel(deliveryDay, today) {
            const from = Date.UTC(today.year, today.month - 1, today.day);
            const to = Date.UTC(deliveryDay.year, deliveryDay.month - 1, deliveryDay.day);
            const offset = Math.round((to - from) / 86400000);

            if (offset <= 0) {
                return config.dayLabels.today;
            }

            return offset === 1 ? config.dayLabels.tomorrow : config.dayLabels.later;
        },

        scrollToDetails() {
            var targetToScroll = document.querySelector('[x-data="initProductSections"]');
            var pageHeader = document.querySelector('.page-header');
            if (targetToScroll && pageHeader) {
                window.scrollTo({
                    top: targetToScroll.getBoundingClientRect().top + window.scrollY - pageHeader.getBoundingClientRect().height,
                    behavior: 'smooth'
                });
                var navButtons = targetToScroll.querySelectorAll('nav button');
                if (navButtons && navButtons.length) {
                    setTimeout(() => {
                        navButtons[navButtons.length - 1].click();
                    }, 300); // Delay to ensure scroll completes
                }
            }
        }
    }
}
</script>

