<script>
function deliveryCountdown(config) {
    return {
        // Same-day delivery timer
        sameDayMessage: config.delivery_message,
        hoursRemaining: config.hours_remaining,
        minutesRemaining: config.minutes_remaining,
        secondsRemaining: config.seconds_remaining,
        cutoffTimestamp: config.cutoff_timestamp,
        
        // Next-day delivery timer
        nextDayMessage: '',
        nextDayHoursRemaining: 0,
        nextDayMinutesRemaining: 0,
        nextDaySecondsRemaining: 0,
        nextDayCutoffTimestamp: 0,
        
        // State management
        intervalId: null,
        showNextDay: false,
         nowTs: 0,      // unix timestamp (seconds)
        nowDate: null, 

        init() {
            this.updateNow();
            this.calculateNextDayCutoff();
            this.calculateNextDayMessage();
            this.startCountdown();
        },
        updateNow() {
        //             const date = new Date(
        //     new Date().toLocaleString('en-US', { timeZone: 'Asia/Dubai' })
        // );
        const date = new Date();
        // date.setDate(date.getDate() - 2);
                this.nowDate = date;
                this.nowTs = Math.floor(date.getTime() / 1000);
        },
        scrollToDetails() {
            var targetToScroll = document.querySelector('[x-data="initProductSections"]');
            var pageHeader = document.querySelector('.page-header');
            if (targetToScroll && pageHeader) {
                window.scrollTo({
                    top: targetToScroll.getBoundingClientRect().top + window.scrollY - pageHeader.getBoundingClientRect().height,
                    behavior: 'smooth'
                });
                var navButtons = targetToScroll.querySelectorAll('nav button');
                if (navButtons && navButtons.length) {
                    setTimeout(() => {
                        navButtons[navButtons.length - 1].click();
                    }, 300); // Delay to ensure scroll completes
                    // navButtons[navButtons.length - 1].click();
                }
            }
        },
        startCountdown() {
            // Update immediately
            this.updateCountdown();
            
            // Update every second
            this.intervalId = setInterval(() => {
                this.updateCountdown();
            }, 1000);
        },

        updateCountdown() {
           this.updateNow();
            
            if (this.showNextDay) {
                // Update next-day timer
                this.updateNextDayTimer();
            } else {
                // Update same-day timer
                this.updateSameDayTimer();
            }
        },

        updateSameDayTimer() {
            const timeRemaining = this.cutoffTimestamp - this.nowTs;

            if (timeRemaining <= 0) {
                // Same-day cutoff passed, switch to next-day
                this.switchToNextDay();
                return;
            }

            // Calculate hours, minutes, and seconds
            this.hoursRemaining = Math.floor(timeRemaining / 3600);
            this.minutesRemaining = Math.floor((timeRemaining % 3600) / 60);
            this.secondsRemaining = timeRemaining % 60;
        },

        updateNextDayTimer() {
            const timeRemaining = this.nextDayCutoffTimestamp - this.nowTs;
            if (timeRemaining <= 0) {
                // Next-day cutoff also passed, reload page to recalculate
                clearInterval(this.intervalId);
                // window.location.reload();
                return;
            }

            // Calculate hours, minutes, and seconds for next-day
            this.nextDayHoursRemaining = Math.floor(timeRemaining / 3600);
            this.nextDayMinutesRemaining = Math.floor((timeRemaining % 3600) / 60);
            this.nextDaySecondsRemaining = timeRemaining % 60;
        },

        switchToNextDay() {
            // Switch display from same-day to next-day
            this.showNextDay = true;
            
            // Start updating next-day timer
            this.updateNextDayTimer(Math.floor(Date.now() / 1000));
        },

        calculateNextDayCutoff() {
            // Next day cutoff is current cutoff + 24 hours
            this.nextDayCutoffTimestamp = this.cutoffTimestamp + (24 * 60 * 60);
            const now = this.nowDate;
            const tomorrow = new Date(now);
            tomorrow.setDate(tomorrow.getDate() + 1);
             if(tomorrow.getDay() === 0){
                    while (tomorrow.getDay() === 0) {
                         tomorrow.setDate(tomorrow.getDate() + 1);
                        this.nextDayCutoffTimestamp = this.cutoffTimestamp + (24 * 60 * 60);

                    }
                }
        },
        // calculateNextDayCutoff() {
        //     const nextDay = new Date(this.nowDate);
        //     nextDay.setDate(nextDay.getDate() + 1);

        //     // Skip weekends
        //     while (nextDay.getDay() === 0 || nextDay.getDay() === 6) {
        //         nextDay.setDate(nextDay.getDate() + 1);
        //     }

        //     // Preserve cutoff time, only shift the date
        //     const cutoff = new Date(this.cutoffTimestamp * 1000);
        //     nextDay.setHours(
        //         cutoff.getHours(),
        //         cutoff.getMinutes(),
        //         cutoff.getSeconds()
        //     );

        //     this.nextDayCutoffTimestamp = Math.floor(nextDay.getTime() / 1000);
        // },

        // calculateNextDayMessage() {
        //     const now = new Date();
        //     const tomorrow = new Date(now);
        //     tomorrow.setDate(tomorrow.getDate() + 1);
        //     let checkdayisWeekend = false;
            
        //     // Skip weekends if needed
        //     while (tomorrow.getDay() === 0 || tomorrow.getDay() === 6) {
        //         checkdayisWeekend = true;
        //         tomorrow.setDate(tomorrow.getDate() + 1);
        //     }
            
        //     const options = { day: 'numeric', month: 'short' };
        //     const formattedDate = tomorrow.toLocaleDateString('en-US', options);
        //     this.nextDayMessage = `FREE delivery ${checkdayisWeekend ? 'on' : 'Tomorrow'}, ${formattedDate}.`;
        // },
         calculateNextDayMessage() {
            const deliveryDate = new Date(config.current_time_formatted);
            deliveryDate.setDate(deliveryDate.getDate() + 1);

            let isWeekendShifted = false;
            while (deliveryDate.getDay() === 0 || deliveryDate.getDay() === 6) {
                isWeekendShifted = true;
                deliveryDate.setDate(deliveryDate.getDate() + 1);
            }

            const formattedDate = deliveryDate.toLocaleDateString('en-US', {
                day: 'numeric',
                month: 'short'
            });

            this.nextDayMessage = `FREE delivery ${
                isWeekendShifted ? 'on' : 'Tomorrow'
            }, ${formattedDate}.`;
        },

        destroy() {
            if (this.intervalId) {
                clearInterval(this.intervalId);
            }
        }
    }
}
</script>

