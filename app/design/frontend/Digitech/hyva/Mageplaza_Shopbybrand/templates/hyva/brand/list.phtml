<script>
    function initListBrand() {
        return {
            isLoading: false,
            checkBrand (el) {
                let self = this;
                document.querySelectorAll('.brand-options li').forEach(item => {
                    item.addEventListener('click', function() {
                        if (!this.classList.contains('disabled')) {
                            document.querySelectorAll('.brand-options li').forEach(li => li.classList.remove('active'));
                            this.classList.add('active');
                        }
                    });
                });

                document.querySelectorAll('.category-nav-list li').forEach(item => {
                    item.addEventListener('click', function() {
                        if (!this.classList.contains('disabled')) {
                            document.querySelectorAll('.category-nav-list li').forEach(li => li.classList.remove('active'));
                            this.classList.add('active');
                        }
                    });
                });

                document.querySelectorAll('.navigation li.mpbrand-top-link').forEach(item => item.classList.add('active'));


                let  config = {
                    loadUrl: '<?php echo /** @noEscape */ $block->getUrl("mpbrand/index/"); ?>',
                    brandListStyle: '<?php echo /** @noEscape */ $helper->getBrandConfig("brandlist_style"); ?>'
                };
                let listFilter = document.querySelectorAll('.brand-options .control');
                listFilter?.forEach(itemfilter => {
                    itemfilter.addEventListener('click', function (event) {
                        if (event.target.tagName.toLowerCase() === 'a') {
                            event.preventDefault();
                            let char = event.target.getAttribute('data-filter');
                            if (char !== 'all') {
                                char = char.substring(1);
                            }
                            const url = `${config.loadUrl}?char=${char}`;
                            loadMore(url, '', char);
                            if (!document.querySelector('.show-more a')) {
                                if (char !== 'all') {
                                    enableScroll(char);
                                }
                            }
                        }
                    });
                });
                function enableScroll(char) {
                    if (char !== 'all') {
                        window.addEventListener('scroll', scrollHandler);
                    }
                }
                function scrollHandler() {
                    const nextItem = document.querySelector('li.item.pages-item-next a.action.next');
                    const char = document.querySelector('.brand-options .control.active .filter').getAttribute('data-filter');
                    if (nextItem && char !== 'all') {
                        const listEl = document.querySelector('ol.products.list.items.product-items');
                        if (listEl && (window.scrollY >= listEl.offsetTop + listEl.offsetHeight - window.innerHeight)) {
                            if (self.isLoading === false) {
                                loadMore(nextItem.getAttribute('href'), listEl, char);
                                self.isLoading = true;
                            }
                        }
                    }
                }
                function loadMore(url, element, char) {
                    self.isLoading = true;
                    const currentDate = new Date();
                    const timestamp = currentDate.getTime();
                    fetch(url + `&_=${timestamp}`, {
                            method: 'GET',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-Requested-With': 'XMLHttpRequest',
                            },
                        }
                    ).then(response => {
                            return response.json();
                        }
                    ).then(data => {
                        if (element === '') {
                            if (config.brandListStyle === '0') {
                                document.querySelector('.brand-mix-container.products-grid').innerHTML = data.data;
                            } else {
                                document.querySelector('.products-grid').innerHTML = data.data;
                            }
                        } else {
                            if (config.brandListStyle === '0') {
                                const newItems = new DOMParser().parseFromString(data.data, 'text/html')
                                .querySelector('ol.products.list.items.product-items').innerHTML.trim();
                                const lastItem = document.querySelectorAll('.items.product-items li');
                                if (lastItem.length) {
                                    lastItem[lastItem.length - 1].insertAdjacentHTML('afterend', newItems);
                                }
                                document.querySelector('ul.items.pages-items').innerHTML = new DOMParser().parseFromString(data.data, 'text/html').querySelector("ul.items.pages-items").innerHTML.trim();
                                // quickView();
                                // modalPopup();
                            }
                        }
                        if (char !== 'all') {
                            let paginateEl = document.querySelector('.pagination-container.toolbar');
                            if(paginateEl) {
                                paginateEl.style.display = 'none';
                            }
                        }
                        if (char === 'all') {
                            const showMoreDivs = document.querySelectorAll('.show-more');
                            showMoreDivs.forEach(showMoreDiv => {
                                showMoreDiv.classList.add('text-center');
                                setTimeout(() => {
                                    const anchorElement = showMoreDiv.querySelector('a');
                                    if (anchorElement) {
                                        anchorElement.classList.add('btn', 'text-white', 'bg-primary', 'my-5', 'px-2', 'py-2');
                                    }
                                }, 100);
                                self.showMore(showMoreDiv);
                            });
                        }
                        self.openModalView(el.querySelector('div'));
                        self.showMore(el.querySelector('div'));
                        let showMoreDiv = el.querySelector('div');
                        if(showMoreDiv){
                            showMoreDiv.classList.add('text-center');
                            setTimeout(() => {
                                let anchorElement = showMoreDiv.querySelector('.show-more a');
                                if (anchorElement) {
                                    anchorElement.classList.add('btn', 'text-white', 'bg-primary', 'my-5', 'px-2', 'py-2');
                                } 
                            }, 100);
                            self.showMore(showMoreDiv);
                        }
                        self.isLoading = false;
                    }).catch(error => {
                        console.log(error);
                    });
                }


            },
            openModalView(event) {
                let quickviewUrl = '<?= /** @noEscape */ $helper->getQuickViewUrl() ?>';

                event.querySelectorAll('.open_model').forEach(item => {
                    item.addEventListener('click', function() {
                        let loader = document.querySelector('.modal-view-brand #ln_overlay');
                        loader.style.display = 'block';
                        window.dispatchEvent(
                            new CustomEvent('hyva-modal-show', {detail: {dialog: 'view-dialog-brand'}})
                        );
                        var brand = item.getAttribute('id');
                        var url = quickviewUrl + brand;

                        fetch(url, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'X-Requested-With': 'XMLHttpRequest',
                                },
                            }
                        ).then(response => {
                                return response.json();
                            }
                        ).then(response => {
                            event.querySelector('.brand_title').textContent = response.brand['value'];
                            var quickviewImg = event.querySelector('.quickview_img');
                            if (parseInt(response.brand['swatch_type']) === 1) {
                                var img = document.createElement('img');
                                img.className = 'quickview_img';
                                img.alt = '';
                                quickviewImg.parentNode.replaceChild(img, quickviewImg);
                                img.style.backgroundColor = response.brand['swatch_value'];
                            } else {
                                if (response.brand['image'] === null) {
                                    quickviewImg.src = '';
                                } else {
                                    quickviewImg.src = response.brand['image'];
                                }
                            }
                            let relatedProEl = event.querySelector('.related-product-modal-content');
                            if(relatedProEl) {
                                relatedProEl.innerHTML = response.products;
                                hyva.activateScripts(relatedProEl);
                                let amastyDiv = relatedProEl.querySelector('#amasty-shopby-product-list');
                                if (amastyDiv) {
                                    while (amastyDiv.attributes.length > 0) {
                                        amastyDiv.removeAttribute(amastyDiv.attributes[0].name);
                                    }
                                }
                                let toolbarDiv = relatedProEl.querySelector('.toolbar.toolbar-products');
                                if (toolbarDiv) {
                                    let navElement = toolbarDiv.querySelector('nav');
                                    if (navElement) {
                                        navElement.remove();
                                    }
                                }
                                let ulElement = relatedProEl.querySelector('ul');
                                if (ulElement) {
                                    ulElement.className = "product-category-list mx-auto pt-4 pb-4 grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3";
                                }
                            }
                            var brandDescription = document.createElement('p');
                            brandDescription.innerHTML = response.brand['short_description'];
                            event.querySelector('.brand_description').innerHTML = '';
                            event.querySelector('.brand_description').appendChild(brandDescription);

                        }).catch(error => {
                            console.log(error);
                        }).finally(()=>{
                            loader.style.display = 'none';
                        });

                    });
                });
            },
            showMore: function (el) {
                let self = this;
                let config = {
                    loadUrl: '<?php echo /** @noEscape */ $block->getUrl("mpbrand/index/showmore"); ?>'
                };
                el.querySelectorAll('.show-more a').forEach(function (link) {
                    link.addEventListener('click', function (event) {
                        event.preventDefault();
                        var char           = this.getAttribute('value');
                        var countBrandChar = document.querySelectorAll('.brand-list-container.' + char + ' li').length;
                        var url            = config.loadUrl + '?char=' + char + '&count=' + countBrandChar;
                        fetch(url)
                        .then(response => response.json())
                        .then(data => {
                            var productItems = document.querySelector('.' + char + ' .brand-list-content .product-items');
                            if (productItems) {
                                productItems.innerHTML = data.data;
                                self.openModalView(el);
                            }
                        })
                        .catch(error => {
                            console.log(error);
                        });
                    });
                });

                el.querySelectorAll('.product-list-container .action').forEach(function (action) {
                    action.addEventListener('click', function () {
                        this.classList.toggle('active');
                        var brandListContent;
                        brandListContent = this.closest('.product-list-container').querySelector('.brand-list-content');
                        if (brandListContent) {
                            brandListContent.style.display = brandListContent.style.display === 'none' ? 'block' : 'none';
                        }
                    });
                });
            }
        }

    }
</script>

