        font-size: 35px;
        content: '\203A';
        text-align: center;
        transform: rotate(180deg);
    }
    .product-list-container .action {
        transform: rotate(270deg);
    }
    .product-list-container .action.active {
        transform: rotate(90deg);
    }
    .product-list-container .brand-char {
        display: flex;
        justify-content: space-between;
        width: 100%;
        margin-top: 10px;
        padding-bottom: 10px;
        border-bottom: 1px solid #D4D4D4;
        margin-bottom: 5px;
    }
    .brand-char .brand-char-title {
        float: left;
        font-weight: 700;
        font-size: 25px;
        width: 3%;
        margin-top: 10px;
    }
    .show-more {
        text-align: center;
    }
    .block-brand-list .brand-list-content .show-more a {
        background: #ED1C24;
    }
    .block-brand-list .brand-list-content.show-more a:hover {
        text-decoration: underline;
    }
</style>
