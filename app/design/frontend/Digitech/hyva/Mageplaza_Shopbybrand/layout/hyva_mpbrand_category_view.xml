<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="hyva_modal"/>
    <body>
        <referenceBlock name="brand.category.list">
            <action method="setTemplate" ifconfig="shopbybrand/general/enabled">
                <argument name="template" xsi:type="string">Mageplaza_Shopbybrand::hyva/category/list.phtml</argument>
            </action>
        </referenceBlock>

        <referenceBlock name="brand.category.list.alpha">
            <action method="setTemplate" ifconfig="shopbybrand/general/enabled">
                <argument name="template" xsi:type="string">Mageplaza_Shopbybrand::hyva/brand/list/alphabet.phtml</argument>
            </action>
        </referenceBlock>

        <referenceBlock name="brand.category.list.listing">
            <action method="setTemplate" ifconfig="shopbybrand/general/enabled">
                <argument name="template" xsi:type="string">Mageplaza_Shopbybrand::hyva/brand/list/listing.phtml</argument>
            </action>
        </referenceBlock>

        <referenceBlock name="brand.search">
            <action method="setTemplate" ifconfig="shopbybrand/brandpage/search/enable">
                <argument name="template" xsi:type="string">Mageplaza_Shopbybrand::hyva/brand/search.phtml</argument>
            </action>
        </referenceBlock>

        <referenceContainer name="content">
            <block name="category.products.list.js.compare" template="Magento_Catalog::product/list/js/compare.phtml" ifconfig="shopbybrand/general/enabled"/>
            <block name="category.products.list.js.wishlist" template="Magento_Catalog::product/list/js/wishlist.phtml" ifconfig="shopbybrand/general/enabled"/>
            <block name="category.products.list.js.price-box" template="Magento_Catalog::product/list/js/price-box.phtml" ifconfig="shopbybrand/general/enabled"/>
            <block name="category.products.list.js_form" template="Mageplaza_Shopbybrand::hyva/brand/list/js_form.phtml" ifconfig="shopbybrand/general/enabled"/>

        </referenceContainer>
    </body>
</page>
