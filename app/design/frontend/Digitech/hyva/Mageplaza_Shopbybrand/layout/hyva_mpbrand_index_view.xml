<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <!-- <head>
        <script src="Mageplaza_Shopbybrand::js/remove.js"></script>
    </head> -->
    <body>
        <referenceContainer name="columns.top">
            <block class="Mageplaza\Shopbybrand\Block\Brand\View" name="brand.name" template="Mageplaza_Shopbybrand::hyva/brand/brand_title.phtml"/>
        </referenceContainer>
        <referenceBlock name="breadcrumbs">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Magento_Theme::html/breadcrumbs.phtml</argument>
            </action>
        </referenceBlock>
        <move element="breadcrumbs" destination="page.top" after="-" />
        <referenceBlock name="brand.category.products.list">
            <action method="setTemplate" ifconfig="shopbybrand/general/enabled">
                <argument name="template" xsi:type="string">Mageplaza_Shopbybrand::hyva/brand/productList.phtml</argument>
            </action>
        </referenceBlock>

        <referenceBlock name="related_brands">
            <action method="setTemplate" ifconfig="shopbybrand/general/enabled">
                <argument name="template" xsi:type="string">Mageplaza_Shopbybrand::hyva/brand/related_brands.phtml</argument>
            </action>
        </referenceBlock>


        <!-- <referenceBlock name="brand.info">
            <action method="setTemplate" ifconfig="shopbybrand/general/enabled">
                <argument name="template" xsi:type="string">Mageplaza_Shopbybrand::hyva/brand_info.phtml</argument>
            </action>
        </referenceBlock> -->

        <move element="category.products.list" destination="brand.category.products.list"/>

        <!-- <referenceBlock name="product_list_toolbar">
            <action method="setTemplate" ifconfig="shopbybrand/general/enabled">
                <argument name="template" xsi:type="string">Magento_Catalog::product/list/toolbar.phtml</argument>
            </action>
        </referenceBlock> -->

        <referenceBlock name="product_list_item">
            <action method="setTemplate" ifconfig="shopbybrand/general/enabled">
                <argument name="template" xsi:type="string">Magento_Catalog::product/list/item.phtml</argument>
            </action>
        </referenceBlock>

        <move element="brand.info" destination="above.footer" before="-"/>
        <referenceContainer name="category.image.block" remove="true" />
    </body>
</page>
