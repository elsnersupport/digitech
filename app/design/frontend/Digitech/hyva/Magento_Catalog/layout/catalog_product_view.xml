<page
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    layout="1column"
    xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd"
>
    <body>
        <referenceBlock name="product.info.details">
            <arguments>
                <argument name="divider" xsi:type="boolean">false</argument>
            </arguments>
            <referenceBlock name="description" template="Magento_Catalog::product/accordian/description/description.phtml">
                <arguments>
                    <argument translate="true" name="title_template" xsi:type="string">Magento_Catalog::product/accordian/description/description-section-title.phtml</argument>
                </arguments>
            </referenceBlock>
            <block name="tech-specification" class="Magento\Catalog\Block\Product\View" template="Magento_Catalog::product/accordian/tech-specification.phtml" group="detailed_info">
                <arguments>
                    <argument translate="true" name="title" xsi:type="string">Technical Specification</argument>
                    <argument name="sort_order" xsi:type="string">30</argument>
                </arguments>
            </block>
            <block name="inbox" class="Magento\Catalog\Block\Product\View" template="Magento_Catalog::product/accordian/in-box.phtml" group="detailed_info">
                <arguments>
                    <argument translate="true" name="title" xsi:type="string">In the Box</argument>
                    <argument name="sort_order" xsi:type="string">40</argument>
                </arguments>
            </block>
            <block class="Magento\Catalog\Block\Product\View" name="product.info.deliverydetails" template="Magento_Catalog::product/accordian/deliveryandshipping.phtml" group="detailed_info" >
                <arguments>
                    <argument translate="true" name="title" xsi:type="string">Delivery &amp; Shipping</argument>
                	<argument name="sort_order" xsi:type="string">50</argument>
                </arguments>
            </block>
        </referenceBlock>
        <move element="page.main.title" destination="product.info" as="product.info.title" />
        <referenceBlock name="page.main.title">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Magento_Theme::html/product-detail-page-title.phtml</argument>
            </action>
        </referenceBlock>
        <referenceBlock name="product.attributes" remove="true"/>
        <referenceBlock name="related">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Magento_Catalog::product/slider/detail-page-product-slider.phtml</argument>
            </action>
            <arguments>
                <argument name="item_template" xsi:type="string">Magento_Catalog::product/product-detail-item.phtml</argument>
                <argument name="container_template" xsi:type="string">Magento_Catalog::product/slider/product-detail-slider-container.phtml</argument>
                <argument name="type" xsi:type="string">related</argument>
                <argument name="title" xsi:type="string" translate="true">Products You Might Also Like...</argument>
                <argument name="heading_tag" xsi:type="string">h2</argument>
                <argument name="page_size" xsi:type="number">15</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="upsell">
            <action method="setTemplate">
                <argument name="template" xsi:type="string">Magento_Catalog::product/slider/detail-page-product-slider.phtml</argument>
            </action>
            <arguments>
                <argument name="item_template" xsi:type="string">Magento_Catalog::product/product-detail-item.phtml</argument>
                <argument name="container_template" xsi:type="string">Magento_Catalog::product/slider/product-detail-slider-container.phtml</argument>
                <argument name="type" xsi:type="string">upsell</argument>
                <argument name="title" xsi:type="string" translate="true">Similar Products</argument>
                <argument name="heading_tag" xsi:type="string">h2</argument>
                <argument name="page_size" xsi:type="number">15</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="description">
            <arguments>
                <argument name="title" xsi:type="string" translate="true">Description</argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
